units				metal
atom_style			atomic
boundary			p p f

lattice				fcc 3.615
read_data			hybrid_rough.data

group				substrate_group type 1
group				heated_group type 2 3

pair_style			eam/alloy
pair_coeff			* * CuYM.eam.alloy Cu Cu Cu
neighbor			0.3 bin
neigh_modify		delay 5

compute				real_temp heated_group temp
compute_modify		real_temp dynamic/dof yes extra/dof 0

velocity			substrate_group set 0 0 0
velocity			heated_group create 698 114514 rot yes dist gaussian

timestep			0.005
fix					1 all nve
fix					2 substrate_group setforce 0 0 0
fix					3 heated_group langevin 698 698 0.5 1949
run					3000
reset_timestep				0

region				deposit_region block $(xlo) $(xhi) $(ylo) $(yhi) &
					$(6.0*3.615) $(zhi) units box
fix					4 heated_group deposit 840618 3 30 2025 region deposit_region &
					local 0.8 0.8 0.5
#Deposit one atom every 50 steps until 7068*72 atoms (72 (111) monolayer) are deposited. The atom will be placed ~0.8*a0 above the system
fix					5 heated_group wall/reflect zhi EDGE

thermo				100000
thermo_modify		temp real_temp

dump				1 all atom 500000 dump_hybrid_rough.xyz

restart			500000 restart/restart_hybrid
run					25218600
write_restart		restart/final
